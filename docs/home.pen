            {
              "type": "text",
              "id": "sMvop",
              "name": "Audience Headline",
              "fill": "$white",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "This is for businesses that got more\ncomplicated as they grew.",
              "lineHeight": 1.3,
              "fontFamily": "$font-sans",
              "fontSize": 30,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "p2BaK",
              "name": "Audience Context",
              "fill": "#FFFFFFAA",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Especially growing e-commerce and lifestyle brands where systems like NetSuite, Snowflake, and Looker now sit between more people, more processes, and more decisions than they used to.",
              "lineHeight": 1.7,
              "fontFamily": "$font-sans",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "N6ic69",
              "name": "Audience Bridge",
              "fill": "#FFFFFFCC",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The business works. But it has become harder to understand from end to end.",
              "lineHeight": 1.6,
              "fontFamily": "$font-sans",
              "fontSize": 16,
              "fontWeight": "500"
            },
            {
              "type": "frame",
              "id": "KCbH5",
              "name": "Symptoms",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "byhXr",
                  "name": "Symptom 1",
                  "fill": "#FFFFFF88",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You can feel it when a simple question requires three people.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "RYH49",
                  "name": "Symptom 2",
                  "fill": "#FFFFFF88",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When two departments bring different numbers to the same meeting.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X7CFF",
                  "name": "Symptom 3",
                  "fill": "#FFFFFF88",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When a project crosses enough systems that nobody quite owns the whole thing.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "XoAop",
                  "name": "Symptom 4",
                  "fill": "#FFFFFF88",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When the person who \"just knows how it works\" becomes part of the infrastructure.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
