                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "n9WBY4",
                  "name": "Maybe 3",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Maybe the business has outgrown systems that used to work perfectly well.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "jDW5p",
                  "name": "Maybe 4",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Maybe a manual workaround has quietly become part of how the company operates.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "z0SBNb",
                  "name": "Maybe 5",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Maybe you're considering a major data, AI, reporting, or technology initiative and aren't sure what has to be true first.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
