---
import { diagnosticForm } from '../data/site-data';
import Icon from './Icon.astro';

const inputClass =
	'w-full rounded-lg border border-border-soft bg-white px-4 py-3 text-base text-navy placeholder:text-secondary/50 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none aria-invalid:border-accent';
const labelClass = 'mb-1.5 block text-sm font-semibold text-navy';
const errorClass = 'mt-1 hidden text-sm text-accent';
---

<dialog
	id="diagnostic-dialog"
	aria-labelledby="diagnostic-heading"
	class="m-auto w-[calc(100%-32px)] max-w-[520px] rounded-2xl bg-paper-white p-0 text-navy shadow-[0_6px_32px_#0000001A] backdrop:bg-navy-dark/70"
>
	<div class="relative p-6 md:p-10">
		<button
			type="button"
			data-close-diagnostic
			aria-label="Close"
			class="absolute top-4 right-4 cursor-pointer rounded-md p-1 text-secondary transition hover:text-navy"
		>
			<Icon name="x" size={20} />
		</button>

		<div data-form-view>
			<h2 id="diagnostic-heading" class="pr-8 text-2xl font-bold text-navy md:text-[28px]">{diagnosticForm.heading}</h2>
			<p class="mt-2 text-base leading-[1.6] text-secondary">{diagnosticForm.subtext}</p>

			<form id="diagnostic-form" class="mt-6 flex flex-col gap-4" novalidate>
				<div>
					<label for="lead-name" class={labelClass}>Name <span class="text-accent">*</span></label>
					<input id="lead-name" name="name" autofocus type="text" autocomplete="name" required maxlength="50" class={inputClass} aria-describedby="lead-name-error" />
					<p id="lead-name-error" data-error-for="name" class={errorClass}></p>
				</div>
				<div>
					<label for="lead-email" class={labelClass}>Email <span class="text-accent">*</span></label>
					<input id="lead-email" name="email" type="email" autocomplete="email" required class={inputClass} aria-describedby="lead-email-error" />
					<p id="lead-email-error" data-error-for="email" class={errorClass}></p>
				</div>
				<div>
					<label for="lead-phone" class={labelClass}>Phone <span class="font-normal text-secondary">(optional)</span></label>
					<input id="lead-phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
				</div>
				<div>
					<label for="lead-details" class={labelClass}>{diagnosticForm.detailsLabel} <span class="font-normal text-secondary">(optional)</span></label>
					<textarea id="lead-details" name="details" rows="3" maxlength="500" class:list={[inputClass, 'resize-none']} aria-describedby="lead-details-error"></textarea>
					<p id="lead-details-error" data-error-for="details" class={errorClass}></p>
				</div>

				<p data-submit-error role="alert" class="hidden rounded-lg border border-accent/40 bg-accent/10 px-4 py-3 text-sm text-navy"></p>

				<button
					type="submit"
					class="mt-2 inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-accent px-8 py-4 text-base font-bold text-white shadow-[0_3px_10px_#F0644933] transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-60"
				>
					<span data-submit-label>{diagnosticForm.submitLabel}</span>
					<Icon name="arrow-right" size={18} />
				</button>
			</form>
		</div>

		<div data-success-view hidden class="py-6 text-center" role="status">
			<h2 class="text-2xl font-bold text-navy md:text-[28px]">{diagnosticForm.successHeading}</h2>
			<p class="mt-3 text-base leading-[1.6] text-secondary">{diagnosticForm.successMessage}</p>
			<button
				type="button"
				data-close-diagnostic
				class="mt-6 cursor-pointer rounded-lg border border-border-soft px-6 py-3 text-sm font-semibold text-navy transition hover:bg-bg-soft"
			>
				Close
			</button>
		</div>
	</div>
</dialog>

<style>
	:global(body:has(#diagnostic-dialog[open])) {
		overflow: hidden;
	}
</style>

<script>
	import { diagnosticForm } from '../data/site-data';
	import { buildLeadPayload, validateLead, type LeadInput } from '../lib/lead-form';

	const dialog = document.querySelector<HTMLDialogElement>('#diagnostic-dialog')!;
	const form = dialog.querySelector<HTMLFormElement>('#diagnostic-form')!;
	const formView = dialog.querySelector<HTMLElement>('[data-form-view]')!;
	const successView = dialog.querySelector<HTMLElement>('[data-success-view]')!;
	const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
	const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
	const submitError = form.querySelector<HTMLElement>('[data-submit-error]')!;

	function readInput(): LeadInput {
		const data = new FormData(form);
		return {
			name: String(data.get('name') ?? ''),
			email: String(data.get('email') ?? ''),
			phone: String(data.get('phone') ?? ''),
			details: String(data.get('details') ?? ''),
		};
	}

	function showErrors(errors: Partial<Record<keyof LeadInput, string>>) {
		form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
			const field = el.dataset.errorFor as keyof LeadInput;
			const message = errors[field];
			el.textContent = message ?? '';
			el.classList.toggle('hidden', !message);
			const input = form.elements.namedItem(field);
			if (input instanceof HTMLElement) input.setAttribute('aria-invalid', message ? 'true' : 'false');
		});
	}

	function setSubmitting(submitting: boolean) {
		submitButton.disabled = submitting;
		submitLabel.textContent = submitting ? 'Sending…' : diagnosticForm.submitLabel;
	}

	function reset() {
		form.reset();
		showErrors({});
		submitError.classList.add('hidden');
		setSubmitting(false);
		formView.hidden = false;
		successView.hidden = true;
	}

	document.querySelectorAll('[data-open-diagnostic]').forEach((button) => {
		button.addEventListener('click', () => {
			if (!successView.hidden) reset();
			dialog.showModal();
		});
	});

	dialog.querySelectorAll('[data-close-diagnostic]').forEach((button) => {
		button.addEventListener('click', () => dialog.close());
	});

	// Clicks on the backdrop land on the <dialog> element itself.
	dialog.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		submitError.classList.add('hidden');

		const input = readInput();
		const errors = validateLead(input);
		showErrors(errors);
		if (Object.keys(errors).length > 0) {
			const firstInvalid = Object.keys(errors)[0];
			(form.elements.namedItem(firstInvalid) as HTMLElement | null)?.focus();
			return;
		}

		setSubmitting(true);
		try {
			const response = await fetch(diagnosticForm.apiEndpoint, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(buildLeadPayload(input, diagnosticForm.leadSource)),
				mode: 'cors',
				credentials: 'omit',
			});
			if (!response.ok) throw new Error(`Lead submission failed: ${response.status}`);

			formView.hidden = true;
			successView.hidden = false;
			successView.querySelector<HTMLButtonElement>('[data-close-diagnostic]')?.focus();
		} catch (error) {
			console.error(error);
			submitError.textContent = diagnosticForm.errorMessage;
			submitError.classList.remove('hidden');
			setSubmitting(false);
		}
	});
</script>
