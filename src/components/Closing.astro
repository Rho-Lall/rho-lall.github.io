---
import { Image } from 'astro:assets';
import { closing } from '../data/site-data';
import CtaButton from './CtaButton.astro';
import kiteImage from '../images/kite-sky.png';
---

<section class="relative flex min-h-svh items-end overflow-hidden bg-canvas" data-section="10">
	<Image
		src={kiteImage}
		alt="A kite high in a golden evening sky, its string running down toward the ground"
		widths={[900, 1440, 1920]}
		sizes="100vw"
		class="absolute inset-0 h-full w-full object-cover"
	/>
	<div
		class="absolute inset-0 bg-linear-to-b from-canvas/0 via-canvas/70 via-55% to-canvas/97"
		aria-hidden="true"
	>
	</div>

	<div class="relative flex w-full flex-col items-center gap-5 px-6 pb-16 text-center md:px-50 md:pb-25">
		<h2 class="max-w-[28ch] text-[24px] leading-[1.3] font-bold text-text-primary md:text-[28px]">
			{closing.heading}
		</h2>
		<div class="flex flex-col gap-1">
			{closing.decisionLines.map((line) => (
				<p class="text-[15px] leading-[1.6] text-text-secondary">{line}</p>
			))}
		</div>
		<p class="max-w-[62ch] text-[15px] leading-[1.7] text-text-secondary">{closing.growing}</p>
		<p class="max-w-[36ch] text-lg leading-[1.35] font-bold text-text-primary md:text-xl">{closing.quote}</p>
		<span class="h-0.5 w-12 rounded-[1px] bg-accent" aria-hidden="true"></span>
		<h3 class="text-[26px] font-bold text-text-primary md:text-[30px]">{closing.finalHeading}</h3>
		<p class="max-w-[42ch] text-base leading-[1.6] text-text-secondary">{closing.finalSub}</p>
		<CtaButton class="mt-2" />
	</div>
</section>
