---
import { Image } from 'astro:assets';

interface Props {
	name: string;
	problem: string;
	result: string;
	url: string;
	fallbackUrl: string;
	image: ImageMetadata;
}

const { name, problem, result, url, image } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="block">
	<article class="overflow-hidden rounded-xl border border-border-soft bg-white">
		<div class="h-[100px] overflow-hidden rounded-t-lg md:h-[120px]">
			<Image src={image} alt={name} class="h-full w-full object-cover" />
		</div>
		<div class="p-4 md:p-5">
			<p class="text-[15px] font-bold text-navy md:text-base">{name}</p>
			<p class="mt-2 text-sm leading-[1.4] text-secondary md:leading-[1.5]">{problem}</p>
			<p class="mt-2 text-sm font-medium leading-[1.4] text-navy md:leading-[1.5]">{result}</p>
		</div>
	</article>
</a>
