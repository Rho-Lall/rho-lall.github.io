---
import { problem } from '../data/site-data';
---

<section class="flex flex-col gap-4 px-6 py-10 md:p-12">
	<p class="text-lg leading-[1.6] font-medium text-navy md:text-xl">{problem.lead}</p>
	<div class="flex flex-col gap-2">
		{problem.lines.map((line) => (
			<p class="text-base leading-[1.5] text-secondary md:text-lg">{line}</p>
		))}
	</div>
</section>
