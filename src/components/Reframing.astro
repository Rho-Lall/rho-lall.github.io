---
import { reframing } from '../data/site-data';
import Icon from './Icon.astro';
---

<section class="relative flex min-h-svh items-center bg-canvas px-6 py-20 md:px-25 lg:px-50" data-section="05">
	<div class="flex w-full flex-col gap-8">
		<h2 class="max-w-[42ch] text-[22px] leading-[1.35] font-bold text-text-primary md:text-[26px]">
			{reframing.heading}
		</h2>

		<ul class="flex flex-col gap-3.5">
			{reframing.cards.map((card) => (
				<li
					class="flex flex-col gap-3 rounded-md border border-fold-shadow bg-paper px-6 py-5 shadow-[0_2px_8px_#0000000A] sm:flex-row sm:items-center sm:gap-5"
				>
					<span class="flex-1 text-[15px] leading-[1.5] text-text-secondary">{card.from}</span>
					<Icon name="arrow-right" size={20} class="shrink-0 rotate-90 text-sage sm:rotate-0" />
					<span class="flex-1 text-[15px] leading-[1.5] font-semibold text-text-primary">{card.to}</span>
				</li>
			))}
		</ul>

		<p class="text-[17px] font-semibold text-text-primary">{reframing.punchline}</p>
	</div>
</section>
