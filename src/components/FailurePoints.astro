---
import { failurePoints } from '../data/site-data';
import Icon from './Icon.astro';
---

<section class="flex flex-col gap-6 px-6 py-10 md:p-12">
	<h2 class="text-2xl leading-[1.2] font-bold text-navy md:text-[28px]">{failurePoints.heading}</h2>
	<p class="text-base leading-[1.6] text-secondary">{failurePoints.intro}</p>
	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
		{failurePoints.directions.map((direction) => (
			<div class="flex flex-col gap-2 rounded-lg border border-[#D5DFE2] bg-bg-soft p-6 shadow-[0_2px_8px_#0000000A]">
				<h3 class="text-base font-bold text-navy">{direction.label}</h3>
				<p class="text-[15px] leading-[1.6] text-secondary">{direction.description}</p>
			</div>
		))}
	</div>
	<p class="text-base leading-[1.6] text-secondary">{failurePoints.areasIntro}</p>
	<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
		{failurePoints.areas.map((area) => (
			<li class="flex items-center gap-2.5 rounded-lg border border-[#D5DFE2] bg-bg-soft p-4 shadow-[0_2px_6px_#0000000A]">
				<Icon name={area.icon} size={20} class="shrink-0 text-primary" />
				<span class="text-sm font-semibold text-navy">{area.label}</span>
			</li>
		))}
	</ul>
</section>
