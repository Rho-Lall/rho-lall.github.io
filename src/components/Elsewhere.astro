---
import { elsewhereLinks } from '../data/site-data';
---

<section class="px-6 py-10 text-center md:px-12 md:py-[60px]">
	<h2 class="text-2xl font-bold text-navy md:text-[28px]">Connect with me</h2>
	<div class="mt-6 flex flex-col items-center gap-3 md:flex-row md:justify-center md:gap-8">
		{elsewhereLinks.map((link) => (
			<a
				href={link.url}
				target="_blank"
				rel="noopener noreferrer"
				class="text-[15px] font-medium text-primary md:text-base"
			>
				{link.label} →
			</a>
		))}
	</div>
</section>
