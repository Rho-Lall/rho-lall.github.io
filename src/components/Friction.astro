---
import { Image } from 'astro:assets';
import { friction } from '../data/site-data';
import riverImage from '../images/river-kayak.png';
---

<section class="relative flex min-h-svh flex-col bg-canvas md:flex-row-reverse" data-section="02">
	<div class="relative h-60 shrink-0 overflow-hidden md:h-auto md:w-[42%]">
		<Image
			src={riverImage}
			alt="View from a kayak on a river, with rocks breaking the surface and others just below it"
			widths={[600, 1000]}
			sizes="(max-width: 768px) 100vw, 42vw"
			class="h-full w-full object-cover"
			data-parallax
		/>
	</div>

	<div class="flex flex-1 flex-col justify-center gap-8 px-6 py-14 md:px-16 md:py-20 lg:px-30">
		<h2 class="max-w-[16ch] text-[30px] leading-[1.2] font-bold text-text-primary md:text-[38px]">
			{friction.heading}
		</h2>
		<ul class="flex max-w-[52ch] flex-col gap-3.5">
			{friction.painPoints.map((point) => (
				<li class="flex items-start gap-3">
					<span class="mt-3 h-0.5 w-5 shrink-0 rounded-[1px] bg-sage" aria-hidden="true"></span>
					<span class="text-[15px] leading-[1.6] text-text-secondary">{point}</span>
				</li>
			))}
		</ul>
	</div>
</section>
