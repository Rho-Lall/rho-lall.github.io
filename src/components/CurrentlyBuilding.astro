---
import { currentlyBuilding } from '../data/site-data';
---

<section class="px-6 py-10 md:px-12 md:py-[60px]">
	<h2 class="text-2xl font-bold text-navy md:text-[28px]">{currentlyBuilding.heading}</h2>
	<p class="mt-4 text-[15px] leading-[1.5] text-secondary md:text-base md:leading-[1.6]">
		{currentlyBuilding.description}
	</p>
	<a
		href={currentlyBuilding.caseStudyUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="mt-4 inline-block text-base font-semibold text-primary"
	>
		{currentlyBuilding.caseStudyLabel}
	</a>
</section>
