---
import { proofCards } from '../data/site-data';
import ProofCard from './ProofCard.astro';
---

<section class="px-6 py-10 md:px-12 md:py-[60px]">
	<h2 class="text-2xl font-bold text-navy md:text-[28px]">Portfolio</h2>
	<div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
		{proofCards.map((card) => (
			<ProofCard
				name={card.name}
				problem={card.problem}
				result={card.result}
				url={card.repoUrl}
				fallbackUrl={card.fallbackUrl}
			/>
		))}
	</div>
</section>
