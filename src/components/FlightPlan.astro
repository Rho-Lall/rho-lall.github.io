---
import { flightPlan } from '../data/site-data';
import Icon from './Icon.astro';
---

<section class="flex flex-col gap-5 px-6 py-10 md:p-12">
	<h2 class="text-2xl leading-[1.2] font-bold text-navy md:text-[28px]">{flightPlan.heading}</h2>
	<p class="text-base leading-[1.6] text-secondary">{flightPlan.intro}</p>
	<p class="text-base leading-[1.6] text-secondary">{flightPlan.subtext}</p>
	<ul class="flex flex-col gap-2 pl-4">
		{flightPlan.questions.map((question) => (
			<li class="flex items-baseline gap-2 text-base leading-[1.5] font-semibold text-navy">
				<span class="size-1.5 shrink-0 -translate-y-0.5 rounded-full bg-accent" aria-hidden="true"></span>
				{question}
			</li>
		))}
	</ul>
	<div class="pt-4">
		<button
			type="button"
			data-open-diagnostic
			aria-haspopup="dialog"
			class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-accent px-8 py-4 text-base font-bold text-white shadow-[0_3px_10px_#F0644933] transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		>
			{flightPlan.ctaLabel}
			<Icon name="arrow-right" size={18} />
		</button>
	</div>
</section>
