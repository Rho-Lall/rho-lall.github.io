---
// The signature transition: a disturbed rake line in the sand garden (frame 09)
// straightens into the kite string (frame 10). Purely decorative — it starts at
// zero opacity and only ever becomes visible if the scroll script runs.
---

<svg
	data-kite-thread
	class="pointer-events-none fixed inset-0 z-10 h-svh w-full opacity-0"
	viewBox="0 0 100 100"
	preserveAspectRatio="none"
	aria-hidden="true"
>
	<path
		data-kite-path
		d="M 88 54 C 78 46, 70 42, 62 44"
		fill="none"
		stroke="#FFFFFFAA"
		stroke-width="0.22"
		stroke-linecap="round"
		vector-effect="non-scaling-stroke"
	></path>
</svg>
