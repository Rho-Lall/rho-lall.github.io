---
import { Image } from 'astro:assets';
import { identity } from '../data/site-data';
import CtaButton from './CtaButton.astro';
import heroImage from '../images/no-strings-on-me.png';
---

<section id="hero" class="relative flex min-h-svh items-end overflow-hidden bg-charcoal" data-section="01">
	<Image
		src={heroImage}
		alt="Illustration of a marionette figure that has cut its own strings"
		widths={[768, 1280, 1920]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 h-full w-full object-cover"
		data-hero-image
	/>
	<div
		class="absolute inset-0 bg-linear-to-b from-charcoal/0 via-charcoal/55 via-35% to-charcoal/95"
		aria-hidden="true"
	>
	</div>

	<div class="relative w-full px-6 pb-16 md:px-30 md:pb-25">
		<h1 class="text-[44px] leading-none font-extrabold text-white md:text-[72px]">{identity.name}</h1>
		<p class="mt-2.5 text-xl font-medium text-white/75 md:text-[26px]">{identity.title}</p>
		<div class="mt-3.5 flex flex-col gap-1.5">
			{identity.taglines.map((tagline) => (
				<p class="text-sm leading-[1.5] text-white/55 md:text-[15px]">{tagline}</p>
			))}
		</div>
		<p class="mt-3.5 text-[13px] text-white/40">{identity.location}</p>
		<CtaButton class="mt-8" />
	</div>
</section>
