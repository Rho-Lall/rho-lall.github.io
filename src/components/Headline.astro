---
import { headline } from '../data/site-data';
---

<section class="flex flex-col gap-5 bg-navy px-6 pt-10 pb-4 md:px-12 md:pt-12">
	<h2 class="text-[28px] leading-[1.2] font-extrabold text-white md:text-4xl">
		{headline.heading[0]}<br class="hidden md:inline" /> {headline.heading[1]}
	</h2>
	<div class="flex flex-col gap-4">
		{headline.paragraphs.map((paragraph) => (
			<p class="text-base leading-[1.6] text-white/75">{paragraph}</p>
		))}
	</div>
	<p class="text-lg leading-[1.5] font-semibold text-primary">{headline.hook}</p>
</section>
