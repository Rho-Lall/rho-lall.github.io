---
import { ctaLabel } from '../data/site-data';
import Icon from './Icon.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<button
	type="button"
	data-open-diagnostic
	aria-haspopup="dialog"
	class:list={[
		'inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg bg-accent px-7 py-3.5 text-base font-bold text-white shadow-[0_3px_12px_#C4553A40] transition hover:bg-[#AB472F] hover:shadow-[0_5px_18px_#C4553A55] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
		className,
	]}
>
	{ctaLabel}
	<Icon name="arrow-right" size={18} />
</button>
