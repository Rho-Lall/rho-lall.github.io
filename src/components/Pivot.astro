---
import { pivot } from '../data/site-data';
import Threads from './Threads.astro';
---

<section class="relative flex min-h-svh items-center justify-center bg-charcoal px-6 py-20 md:px-50" data-section="03">
	<Threads />
	<div class="relative flex max-w-[38ch] flex-col items-center gap-6 text-center">
		<p class="text-base leading-[1.6] text-white/45 md:text-lg">{pivot.lead}</p>
		<p class="text-[26px] leading-[1.3] font-bold text-white md:text-[34px]">{pivot.statement}</p>
	</div>
</section>
