---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found · rho-lall.com" description="The requested page could not be found.">
	<div class="flex min-h-[65vh] w-full flex-col items-start justify-center gap-8 px-5 py-20 sm:px-8 lg:px-12">
		<p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-brand-primary">404 / wrong turn</p>
		<div class="max-w-2xl">
			<h1 class="font-display text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-7xl">This route isn’t in the map.</h1>
			<p class="mt-6 max-w-xl text-lg leading-8 text-slate">The page may have moved, or the link may have carried a little too much history.</p>
		</div>
		<a href="/" class="inline-flex items-center rounded-full bg-brand-accent px-6 py-3 text-sm font-semibold text-brand-navy-dark no-underline transition-colors hover:bg-brand-accent-muted hover:text-paper">Back to home</a>
	</div>
</Layout>
