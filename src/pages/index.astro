---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CurrentlyBuilding from '../components/CurrentlyBuilding.astro';
import ProofCards from '../components/ProofCards.astro';
import Elsewhere from '../components/Elsewhere.astro';
import Footer from '../components/Footer.astro';
import { socialMeta, personSchema } from '../data/site-data';
---

<BaseLayout title={socialMeta.ogTitle} description={personSchema.description}>
	<div class="py-10 md:py-16">
		<div class="mx-auto max-w-[1024px] rounded-2xl bg-paper-white px-6 shadow-[0_4px_24px_#00000012] md:px-12">
			<Hero />
			<CurrentlyBuilding />
			<div class="border-t border-border-soft"></div>
			<ProofCards />
			<div class="border-t border-border-soft"></div>
			<Elsewhere />
		</div>
	</div>
	<Footer />
</BaseLayout>
