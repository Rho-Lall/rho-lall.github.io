---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Friction from '../components/Friction.astro';
import Pivot from '../components/Pivot.astro';
import ValueProp from '../components/ValueProp.astro';
import Reframing from '../components/Reframing.astro';
import Audience from '../components/Audience.astro';
import OnYourMind from '../components/OnYourMind.astro';
import Outcomes from '../components/Outcomes.astro';
import Credibility from '../components/Credibility.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import DiagnosticDialog from '../components/DiagnosticDialog.astro';
import { socialMeta, personSchema } from '../data/site-data';
---

<BaseLayout title={socialMeta.ogTitle} description={personSchema.description}>
	<Hero />
	<Friction />
	<Pivot />
	<ValueProp />
	<Reframing />
	<Audience />
	<OnYourMind />
	<Outcomes />
	<Credibility />
	<Closing />
	<Footer slot="footer" />
	<DiagnosticDialog slot="footer" />
</BaseLayout>
